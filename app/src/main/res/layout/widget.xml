<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="18dp" android:background="@drawable/glass">
 <TextView android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aniversários" android:textColor="#FFFFFFFF" android:textSize="16sp"/>
 <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginBottom="12dp" android:background="#66FFFFFF"/>
 <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
  <ListView android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="0dp" android:scrollbars="vertical" android:scrollbarStyle="insideOverlay" android:clipToPadding="false"/>
  <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Cadastre seu primeiro aniversário" android:textColor="#BBFFFFFF" android:textSize="14sp"/>
 </FrameLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:id="@+id/manage" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center_vertical" android:text="＋ Cadastrar" android:textColor="#FFFFFFFF" android:textSize="12sp"/>
  <TextView android:id="@+id/order" android:layout_width="wrap_content" android:layout_height="48dp" android:paddingLeft="12dp" android:paddingRight="12dp" android:gravity="center" android:text="↕ Idade" android:textColor="#FFFFFFFF" android:textSize="12sp"/>
  <TextView android:id="@+id/refresh" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:text="↻ Atualizar" android:textColor="#FFFFFFFF" android:textSize="12sp"/>
 </LinearLayout>
</LinearLayout>
